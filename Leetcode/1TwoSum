class Solution:
    @staticmethod
    def twoSum(nums: list[int], target: int) -> list[int] | None:
         # example: [3,2,4]
         # seen = {3: 0, 2: 1 , 4: 2}
         seen = {}
        
         for index, number in enumerate(nums): #O(n)
             diff  = target-number
             if diff not in seen:  # is diff a key in seen, with an index value?
                seen[number] = index  
             else : # is in seen 
                diff_index = seen[diff]
                return [diff_index,index] # key is 


